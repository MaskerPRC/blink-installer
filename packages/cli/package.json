    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "blink-installer-core": "0.2.2"
  },
  "author": "loopsaaage <maskerprc@gmail.com>",
  "repository": {
    "type": "git",
