{
  "name": "blink-installer",
  "version": "0.2.2",
  "description": "Build Windows installers with an HTML/CSS/JS user interface.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "blink-installer": "./dist/cli.js"
  },
